# ASHURA AI Assistant - Environment Configuration
# Copy this file to .env.local and add your preferred AI provider API key.
# If no key is set, ASHURA operates using the built-in autonomous local agent.

# Google Gemini API Key (Recommended)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Or OpenAI API Key
# OPENAI_API_KEY=

# Or Groq API Key (ultra-fast Llama 3)
# GROQ_API_KEY=

# Or local Ollama URL (e.g. http://localhost:11434)
# OLLAMA_HOST=
